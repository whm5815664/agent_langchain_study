{
    "version": "0.2.0",
    "configurations": [
            {
                "name": "MCP: Local Bridge (mcp.startmcpserver)",
                "type": "debugpy",
                "request": "launch",
                "module": "mcp.startmcpserver",
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                },
                "console": "integratedTerminal"
            },
            {
                "name": "Django: HTTPS/WSS (config.https_server)",
            "type": "debugpy",
            "request": "launch",
            "module": "config.https_server",
            "args": [
                "--port", "8000",
                "--bind", "0.0.0.0",
                "--directory", "${workspaceFolder}",
                "--cert-dir", "${workspaceFolder}/certs"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "DJANGO_SETTINGS_MODULE": "config.settings"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Django: Uvicorn HTTP/WS",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "config.asgi:application",
                "--host", "127.0.0.1",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "DJANGO_SETTINGS_MODULE": "config.settings"
            },
            "console": "integratedTerminal"
        }
    ]
}

{
  "tools": [
    {
      "name": "get_device_info",
      "description": "获取本机浏览器/设备信息（UA、屏幕、语言、时区等）",
      "inputSchema": { "type": "object", "properties": {} }
    },
    {
      "name": "get_local_time",
      "description": "获取访客电脑的本地日期时间与时区",
      "inputSchema": { "type": "object", "properties": {} }
    },
    {
      "name": "get_geolocation",
      "description": "请求浏览器定位（需用户授权）",
      "inputSchema": { "type": "object", "properties": {} }
    },
    {
      "name": "read_clipboard",
      "description": "读取剪贴板文本",
      "inputSchema": { "type": "object", "properties": {} }
    },
    {
      "name": "write_clipboard",
      "description": "写入文本到剪贴板",
      "inputSchema": {
        "type": "object",
        "properties": { "text": { "type": "string", "description": "文本内容" } },
        "required": ["text"]
      }
    },
    {
      "name": "show_notification",
      "description": "弹出系统通知",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "标题" },
          "body": { "type": "string", "description": "正文" }
        },
        "required": ["title"]
      }
    },
    {
      "name": "prompt_user",
      "description": "弹出输入框收集用户输入",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "description": "提示文案" },
          "default_value": { "type": "string", "description": "默认值" }
        },
        "required": ["message"]
      }
    },
    {
      "name": "confirm_user",
      "description": "弹出确认框",
      "inputSchema": {
        "type": "object",
        "properties": { "message": { "type": "string", "description": "确认文案" } },
        "required": ["message"]
      }
    },
    {
      "name": "local_storage_get",
      "description": "读取 localStorage",
      "inputSchema": {
        "type": "object",
        "properties": { "key": { "type": "string" } },
        "required": ["key"]
      }
    },
    {
      "name": "local_storage_set",
      "description": "写入 localStorage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["key", "value"]
      }
    },
    {
      "name": "download_text_file",
      "description": "触发下载文本文件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["filename", "content"]
      }
    }
  ]
}
